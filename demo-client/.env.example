# iNAYA Auth 2.0 - Demo OIDC Client Environment

# iNAYA Auth 2.0 OIDC Configuration
# Register your application at https://app.inaya-auth.com/developer/applications

# Your OAuth Client ID (get from developer portal)
INAYA_AUTH_CLIENT_ID="your-client-id-here"

# Your OAuth Client Secret (get from developer portal)
INAYA_AUTH_CLIENT_SECRET="your-client-secret-here"

# iNAYA Auth 2.0 OIDC Issuer
INAYA_AUTH_ISSUER="https://accounts.inaya-auth.com"

# NextAuth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Environment
NODE_ENV="development"

# Optional: Use test environment for development
# INAYA_AUTH_ISSUER="https://test.accounts.inaya-auth.com"
