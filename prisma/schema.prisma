// iNAYA Auth 2.0 — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant Model (Task 42: Multi-Tenant Architecture) ──────────────────────
model Tenant {
  id              String    @id @default(cuid())
  name            String    // Organization name
  slug            String    @unique // URL-friendly identifier
  domain          String?   @unique // Custom domain (optional)
  logoUrl         String?
  settings        Json      @default("{}") // Tenant-specific settings
  plan            TenantPlan @default(FREE)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  users           User[]
  oauthClients    OAuthClient[]
  webhooks        Webhook[]
  apiKeys         ApiKey[]
  subscription    Subscription? // Task 45-46: Billing
  dataRequests    DataRequest[] // Task 51: GDPR data requests
  emailTemplates  EmailTemplate[]
  
  @@index([slug])
  @@index([domain])
  @@map("tenants")
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── User Model ──────────────────────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  tenantId        String    // Task 42: Multi-tenant isolation
  name            String?
  username        String?   @unique
  email           String    @unique
  emailVerified   DateTime?
  backupEmail     String?   // Task 10: Backup email
  image           String?
  password        String?   // For credentials login (hashed with bcrypt)
  phoneNumber     String?   @unique // Task 9: Mobile number
  phoneVerified   DateTime? // Task 9: Phone verification timestamp
  role            Role      @default(USER)
  tenantRole      TenantRole @default(MEMBER) // Task 42: Role within tenant
  isActive        Boolean   @default(true)
  locale          String    @default("en")
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // KYC & Verification (Tasks 35-38)
  isVerified      Boolean   @default(false) // Green tick badge
  verificationTier VerificationTier @default(BASIC)
  kycStatus       KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt  DateTime?
  kycVerifiedAt   DateTime?

  // Relations
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts            Account[]
  sessions            Session[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passkeys            Passkey[]             // Task 13: WebAuthn passkeys
  passwordResetTokens PasswordResetToken[]  // Step 4: Password reset tokens
  twoFactorAuth       TwoFactorAuth?        // Task 20: 2FA TOTP
  ownedOAuthClients   OAuthClient[]         // Task 23: SSO - owned applications
  oauthAuthorizations OAuthAuthorization[]  // Task 25: SSO - granted authorizations
  securityCheckups    SecurityCheckup[]     // Task 31: Security checkup
  loginAlerts         LoginAlert[]          // Task 32: Login alerts
  trustedDevices      TrustedDevice[]       // Task 33: Trusted devices
  proactiveProtections ProactiveProtection[] // Task 33: Proactive protection
  securitySettings    SecuritySettings?     // Task 34: Central security settings
  kycRecords          KYCRecord[]           // Tasks 35-38: KYC records
  loginMethodCooldowns LoginMethodCooldown[] // Tasks 39-41: Login method cooldowns
  gdprConsent         GDPRConsent?          // Task 51: GDPR consent
  dataRequests        DataRequest[]         // Task 51: Data download/delete requests

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([role])
  @@index([tenantId])
  @@map("users")
}

enum TenantRole {
  OWNER
  ADMIN
  DEVELOPER
  MEMBER
}

// ─── Two-Factor Authentication Model (Task 20) ──────────────────────────────
model TwoFactorAuth {
  id             String   @id @default(cuid())
  userId         String   @unique
  secret         String   // Encrypted TOTP secret
  isVerified     Boolean  @default(false)
  isEnabled      Boolean  @default(false)
  backupCodes    Json     // Encrypted array of recovery codes
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auths")
}

// ─── OAuth Client Model (Task 23-24: SSO/OIDC, Task 43: Developer Portal) ───
model OAuthClient {
  id                 String    @id @default(cuid())
  tenantId           String    // Task 42: Multi-tenant isolation
  clientId           String    @unique // Public client ID
  clientSecret       String    // Encrypted client secret
  name               String    // Application name
  description        String?   // Application description
  ownerUserId        String    // User who owns this client
  redirectUris       Json      // Array of allowed redirect URIs
  scopes             Json      // Array of allowed scopes
  isPublic           Boolean   @default(false) // For PKCE flows
  isActive           Boolean   @default(true)
  logoUrl            String?
  websiteUrl         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner              User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorizations     OAuthAuthorization[]
  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]

  @@index([clientId])
  @@index([ownerUserId])
  @@index([tenantId])
  @@map("oauth_clients")
}

// ─── API Key Model (Task 43: Developer Portal) ──────────────────────────────
model ApiKey {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String    // Developer who created this key
  name          String    // Key name (e.g., "Production API Key")
  key           String    @unique // Hashed API key
  keyPrefix     String    // First 8 chars for identification
  permissions   Json      // Array of permissions/scopes
  expiresAt     DateTime? // Optional expiration
  lastUsedAt    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([key])
  @@index([tenantId])
  @@index([userId])
  @@map("api_keys")
}

// ─── Webhook Model (Task 44: Webhooks) ──────────────────────────────────────
model Webhook {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String    // Developer who created this webhook
  url           String    // Webhook endpoint URL
  secret        String    // Webhook signing secret
  events        Json      // Array of event types to subscribe
  isActive      Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@map("webhooks")
}

// ─── Webhook Delivery Log (Task 44: Webhook tracking) ───────────────────────
model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String    // Event type that triggered this delivery
  payload       Json      // Payload sent to webhook
  statusCode    Int?      // HTTP response status code
  response      String?   // Response body (truncated)
  success       Boolean   @default(false)
  attempts      Int       @default(1)
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  
  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ─── OAuth User Authorization (Task 25: SSO) ────────────────────────────────
model OAuthAuthorization {
  id              String    @id @default(cuid())
  userId          String
  clientId        String
  scopes          Json      // Granted scopes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("oauth_authorizations")
}

// ─── OAuth Authorization Code (Task 24: OIDC) ───────────────────────────────
model OAuthAuthorizationCode {
  id            String    @id @default(cuid())
  code          String    @unique
  clientId      String
  userId        String
  redirectUri   String
  scopes        Json
  codeChallenge String?   // PKCE
  codeChallengeMethod String? // PKCE: S256 or plain
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

// ─── OAuth Access Token ─────────────────────────────────────────────────────
model OAuthAccessToken {
  id          String    @id @default(cuid())
  token       String    @unique
  clientId    String
  userId      String
  scopes      Json
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

// ─── OAuth Refresh Token ────────────────────────────────────────────────────
model OAuthRefreshToken {
  id            String    @id @default(cuid())
  token         String    @unique
  clientId      String
  userId        String
  scopes        Json
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("oauth_refresh_tokens")
}

// ─── Password Reset Token Model (Step 4) ────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─── Passkey Model (Task 13: WebAuthn) ──────────────────────────────────────
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique // Base64 encoded
  publicKey       String   @db.Text // Base64 encoded
  counter         BigInt   @default(0)
  deviceType      String   // 'singleDevice' or 'multiDevice'
  backedUp        Boolean  @default(false)
  transports      String[] // ['usb', 'ble', 'nfc', 'internal', 'hybrid']
  name            String?  // User-friendly name for the passkey
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}

// ─── Auth.js v5 Required Models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Role Enum ───────────────────────────────────────────────────────────────
enum Role {
  USER
  MODERATOR
  ADMIN
  ADMIN_HEAD
  CEO
  SUPERADMIN
}

// ─── Refresh Token Model ─────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Audit Log Model ─────────────────────────────────────────────────────────
model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
  PROFILE_UPDATE
  ROLE_CHANGE
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETED
  FAILED_LOGIN
  TOKEN_REFRESH
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ACCOUNT_LINKED
  ACCOUNT_UNLINKED
  BACKUP_EMAIL_UPDATED
  KYC_SUBMITTED
  KYC_VERIFIED
  KYC_REJECTED
}

// ─── OTP Model (Tasks 16-18: Unified OTP for all delivery methods) ───────────
model OtpCode {
  id          String    @id @default(cuid())
  userId      String?
  recipient   String    // email, phone, or telegram chatId
  recipientType String  // 'email', 'phone', 'telegram'
  code        String
  purpose     String    // 'login', 'verify-email', 'verify-phone', 'reset-password'
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([recipient, recipientType])
  @@index([code, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ─── OTP Rate Limiting (Task 18) ─────────────────────────────────────────────
model OtpRateLimit {
  id            String   @id @default(cuid())
  recipient     String
  recipientType String
  count         Int      @default(0)
  windowStart   DateTime
  windowEnd     DateTime
  
  @@unique([recipient, recipientType])
  @@index([windowEnd])
  @@map("otp_rate_limits")
}

// ─── KYC Record Model (Tasks 35-38) ─────────────────────────────────────────
model KYCRecord {
  id                String    @id @default(cuid())
  userId            String
  type              KYCType
  status            KYCStatus @default(PENDING)
  
  // Document details
  documentType      String?   // passport, national_id, driving_license
  documentNumber    String?   // Encrypted
  documentFrontUrl  String?   // Encrypted file path
  documentBackUrl   String?   // Encrypted file path
  
  // Selfie/Liveness
  selfieUrl         String?   // Encrypted file path
  videoSelfieUrl    String?   // Encrypted file path
  livenessScore     Float?    // 0.0 to 1.0
  
  // Face verification
  faceMatchScore    Float?    // 0.0 to 1.0
  
  // Third-party KYC service
  kycProvider       String?   // onfido, jumio, sumsub, etc.
  kycProviderId     String?   // External KYC provider's reference ID
  kycProviderResponse Json?   // Full response from provider
  
  // Review
  reviewedBy        String?   // Admin user ID who reviewed
  reviewedAt        DateTime?
  rejectionReason   String?
  
  // Privacy & Consent (Task 38)
  consentGiven      Boolean   @default(false)
  consentTimestamp  DateTime?
  dataRetentionPolicy String? // How long to keep data
  dataDeletedAt     DateTime?
  
  // Timestamps
  submittedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([kycProvider])
  @@map("kyc_records")
}

// ─── KYC Enums ──────────────────────────────────────────────────────────────
enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KYCType {
  ID_VERIFICATION
  FACE_VERIFICATION
  LIVENESS_CHECK
  FULL_KYC
}

enum VerificationTier {
  BASIC      // No KYC, basic features
  VERIFIED   // KYC completed, green tick badge
  PREMIUM    // Enhanced verification (optional future tier)
}

// ─── CSRF Token Model (Task 50: CSRF Protection) ────────────────────────────
model CSRFToken {
  id        String   @id @default(cuid())
  token     String   @unique
  sessionId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("csrf_tokens")
}

// ─── Security Log Model (Task 50: Security Logging) ─────────────────────────
model SecurityLog {
  id         String   @id @default(cuid())
  eventType  String   // CSRF_VIOLATION, XSS_ATTEMPT, SQLI_ATTEMPT, etc.
  userId     String?
  tenantId   String?
  ipAddress  String
  userAgent  String
  details    Json
  severity   String   // low, medium, high, critical
  createdAt  DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("security_logs")
}

// ─── GDPR Consent Model (Task 51: GDPR Compliance) ──────────────────────────
model GDPRConsent {
  id                  String   @id @default(cuid())
  userId              String   @unique
  privacyPolicyAccepted Boolean @default(false)
  privacyPolicyAcceptedAt DateTime?
  cookieConsent       Json     // { essential: true, analytics: false, marketing: false }
  cookieConsentAt     DateTime?
  dataProcessingAccepted Boolean @default(false)
  dataProcessingAcceptedAt DateTime?
  marketingConsent    Boolean  @default(false)
  marketingConsentAt  DateTime?
  updatedAt           DateTime @updatedAt
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("gdpr_consents")
}

// ─── Data Request Model (Task 51: GDPR Data Download/Delete) ────────────────
model DataRequest {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  type        String   // DOWNLOAD, DELETE
  status      String   // PENDING, PROCESSING, COMPLETED, FAILED
  downloadUrl String?  // For DOWNLOAD requests
  expiresAt   DateTime? // For download links
  processedAt DateTime?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@map("data_requests")
}

// ─── Security Checkup Model (Task 31) ───────────────────────────────────────
model SecurityCheckup {
  id              String   @id @default(cuid())
  userId          String
  securityScore   Int      // 0-100
  checklist       Json     // Array of security checks
  recommendations Json     // Array of recommendations
  lastCheckedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([lastCheckedAt])
  @@map("security_checkups")
}

// ─── Login Alert Model (Task 32) ────────────────────────────────────────────
model LoginAlert {
  id           String   @id @default(cuid())
  userId       String
  ipAddress    String
  userAgent    String
  deviceInfo   Json     // Parsed device information
  location     Json     // IP geolocation data
  riskLevel    String   // 'low', 'medium', 'high', 'critical'
  riskFactors  Json     // Array of risk factors
  isRecognized Boolean  @default(false)
  isAcknowledged Boolean @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@index([riskLevel])
  @@index([isAcknowledged])
  @@map("login_alerts")
}

// ─── Trusted Device Model (Task 33) ─────────────────────────────────────────
model TrustedDevice {
  id            String    @id @default(cuid())
  userId        String
  deviceFingerprint String // Hash of device characteristics
  deviceName    String?
  browser       String
  os            String
  ipAddress     String
  lastUsedAt    DateTime  @default(now())
  trustLevel    String    @default("trusted") // 'trusted', 'restricted'
  expiresAt     DateTime? // Optional expiration
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceFingerprint])
  @@index([isRevoked])
  @@map("trusted_devices")
}

// ─── Proactive Protection Log (Task 33) ─────────────────────────────────────
model ProactiveProtection {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // 'suspicious_login', 'brute_force', 'unusual_activity'
  severity    String   // 'low', 'medium', 'high', 'critical'
  action      String   // 'blocked', 'warned', 'locked'
  details     Json     // Event details
  ipAddress   String?
  userAgent   String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("proactive_protections")
}

// ─── Central Security Settings (Task 34) ────────────────────────────────────
model SecuritySettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  loginAlertsEnabled      Boolean  @default(true)
  trustedDevicesEnabled   Boolean  @default(true)
  proactiveProtection     Boolean  @default(true)
  suspiciousLoginDetection Boolean @default(true)
  locationBasedSecurity   Boolean  @default(true)
  deviceRecognition       Boolean  @default(true)
  automaticLockout        Boolean  @default(true)
  maxFailedAttempts       Int      @default(5)
  lockoutDuration         Int      @default(15) // minutes
  sessionTimeout          Int      @default(30) // minutes
  require2FAForTrusted    Boolean  @default(false)
  notifyOnNewDevice       Boolean  @default(true)
  notifyOnNewLocation     Boolean  @default(true)
  allowedCountries        Json?    // Array of allowed country codes
  blockedIPs              Json?    // Array of blocked IP addresses
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("security_settings")
}

// ─── Login Method Cooldown (Tasks 39-41) ────────────────────────────────────
model LoginMethodCooldown {
  id              String   @id @default(cuid())
  userId          String
  methodType      String   // 'password', '2fa', 'passkey', 'oauth', 'phone'
  methodIdentifier String? // Specific identifier (e.g., oauth provider, phone number)
  cooldownUntil   DateTime // When cooldown expires
  reason          String?  // Why cooldown was applied
  createdAt       DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, methodType, methodIdentifier])
  @@index([userId])
  @@index([cooldownUntil])
  @@map("login_method_cooldowns")
}

// ─── Global Cooldown Settings (Task 41: Super Admin Configurable) ───────────
model GlobalCooldownSettings {
  id                    String   @id @default(cuid())
  passwordCooldownHours Int      @default(24) // Hours to wait after password change
  twoFactorCooldownHours Int     @default(24) // Hours to wait after 2FA change
  passkeyCooldownHours  Int      @default(24) // Hours to wait after passkey change
  oauthCooldownHours    Int      @default(24) // Hours to wait after OAuth link/unlink
  phoneCooldownHours    Int      @default(24) // Hours to wait after phone change
  maxSimultaneousChanges Int     @default(1)   // Max login methods that can change at once
  updatedAt             DateTime @updatedAt
  
  @@map("global_cooldown_settings")
}

// ─── Pricing Plan Model (Task 45: Country-based Pricing) ────────────────────
model PricingPlan {
  id              String    @id @default(cuid())
  name            String    // Starter, Pro, Enterprise
  slug            String    @unique // starter, pro, enterprise
  description     String?
  
  // Features
  maxUsers        Int       // -1 for unlimited
  maxOAuthClients Int       // -1 for unlimited
  maxApiKeys      Int       // -1 for unlimited
  maxWebhooks     Int       // -1 for unlimited
  customDomain    Boolean   @default(false)
  ssoEnabled      Boolean   @default(false)
  advancedSecurity Boolean  @default(false)
  prioritySupport Boolean   @default(false)
  
  // Country-based pricing (JSON structure: {"USD": 29, "BDT": 2500, ...})
  pricing         Json      
  currency        String    @default("USD") // Default currency
  
  // Billing intervals
  billingIntervals Json     // {"monthly": true, "yearly": true, "yearly_discount": 20}
  
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false) // Default plan for new tenants
  stripePriceIdMonthly String?  // Stripe Price ID for monthly
  stripePriceIdYearly  String?  // Stripe Price ID for yearly
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  subscriptions   Subscription[]
  
  @@index([slug])
  @@map("pricing_plans")
}

// ─── Subscription Model (Task 46: Stripe Integration) ───────────────────────
model Subscription {
  id                    String    @id @default(cuid())
  tenantId              String    @unique // One subscription per tenant
  
  planId                String
  plan                  PricingPlan @relation(fields: [planId], references: [id])
  
  // Stripe integration
  stripeSubscriptionId  String?   @unique
  stripeCustomerId      String?
  
  // Subscription details
  status                SubscriptionStatus @default(ACTIVE)
  billingInterval       String    @default("monthly") // monthly or yearly
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  
  // Payment info
  currency              String    @default("USD")
  amount                Float?    // Amount in smallest currency unit (cents)
  
  // Cancellation
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  
  // Trial
  trialStart            DateTime?
  trialEnd              DateTime?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices              Invoice[]
  
  @@index([tenantId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Invoice Model ──────────────────────────────────────────────────────────
model Invoice {
  id                    String    @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id])
  
  // Invoice details
  stripeInvoiceId       String?   @unique
  amount                Float     // Amount in smallest currency unit
  currency              String
  status                InvoiceStatus
  
  // Dates
  periodStart           DateTime
  periodEnd             DateTime
  paidAt                DateTime?
  
  // PDF
  invoicePdfUrl         String?
  
  createdAt             DateTime  @default(now())
  
  @@index([subscriptionId])
  @@index([stripeInvoiceId])
  @@map("invoices")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCERAIN
}



// ─── Email Template System (Step 19) ─────────────────────────────────────────
model EmailTemplate {
  id                String                  @id @default(cuid())
  tenantId          String
  name              String                  // e.g., "welcome", "password-reset", "verification"
  type              EmailTemplateType
  isActive          Boolean                 @default(true)
  activeVersionId   String?                 // Currently active version ID
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions          EmailTemplateVersion[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([type])
}

model EmailTemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  version     Int      // Version number (1, 2, 3, etc.)
  subject     String
  htmlContent String   @db.Text
  textContent String   @db.Text // Plain text version
  variables   Json     // Available variables for this template
  isActive    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
  @@index([isActive])
}

enum EmailTemplateType {
  WELCOME
  VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
  LOGIN_ALERT
  SUBSCRIPTION
  INVOICE
  OTP
  KYC
  CUSTOM
}

// ─── Rate Limit Tracking (Step 20: Comprehensive Rate Limiting) ─────────────
model RateLimit {
  id          String   @id @default(cuid())
  key         String   // Rate limit key (e.g., "ip:192.168.1.1", "user:abc123", "endpoint:/api/auth/login")
  type        RateLimitType // Type of rate limit
  count       Int      @default(0) // Current request count
  windowStart DateTime // Window start time
  windowEnd   DateTime // Window end time
  blocked     Boolean  @default(false) // If currently blocked
  blockedUntil DateTime? // When block expires
  
  @@unique([key, type])
  @@index([key])
  @@index([type])
  @@index([windowEnd])
  @@index([blocked])
  @@map("rate_limits")
}

enum RateLimitType {
  IP_GLOBAL      // Global IP rate limit
  IP_AUTH        // IP rate limit for auth endpoints
  USER_GLOBAL    // Global user rate limit
  USER_AUTH      // User rate limit for auth endpoints
  USER_API       // User rate limit for API endpoints
  ENDPOINT       // Endpoint-specific rate limit
  TENANT_API     // Tenant API rate limit
}

// ─── Rate Limit Configuration (Step 20: Configurable Rate Limits) ───────────
model RateLimitConfig {
  id              String   @id @default(cuid())
  name            String   @unique // Config name (e.g., "auth_login", "api_default")
  type            RateLimitType
  maxRequests     Int      // Max requests per window
  windowSeconds   Int      // Window size in seconds
  blockDuration   Int      // Block duration in seconds (0 = no blocking)
  description     String?  // Description of this rate limit
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([type])
  @@index([isActive])
  @@map("rate_limit_configs")
}
