// iNAYA Auth 2.0 — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User Model ──────────────────────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String    @unique
  emailVerified   DateTime?
  backupEmail     String?   // Task 10: Backup email
  image           String?
  password        String?   // For credentials login (hashed with bcrypt)
  phoneNumber     String?   @unique // Task 9: Mobile number
  phoneVerified   DateTime? // Task 9: Phone verification timestamp
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  locale          String    @default("en")
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // KYC & Verification (Tasks 35-38)
  isVerified      Boolean   @default(false) // Green tick badge
  verificationTier VerificationTier @default(BASIC)
  kycStatus       KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt  DateTime?
  kycVerifiedAt   DateTime?

  // Relations
  accounts            Account[]
  sessions            Session[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passkeys            Passkey[]             // Task 13: WebAuthn passkeys
  passwordResetTokens PasswordResetToken[]  // Step 4: Password reset tokens
  twoFactorAuth       TwoFactorAuth?        // Task 20: 2FA TOTP
  ownedOAuthClients   OAuthClient[]         // Task 23: SSO - owned applications
  oauthAuthorizations OAuthAuthorization[]  // Task 25: SSO - granted authorizations
  securityCheckups    SecurityCheckup[]     // Task 31: Security checkup
  loginAlerts         LoginAlert[]          // Task 32: Login alerts
  trustedDevices      TrustedDevice[]       // Task 33: Trusted devices
  proactiveProtections ProactiveProtection[] // Task 33: Proactive protection
  securitySettings    SecuritySettings?     // Task 34: Central security settings
  kycRecords          KYCRecord[]           // Tasks 35-38: KYC records

  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([role])
  @@map("users")
}

// ─── Two-Factor Authentication Model (Task 20) ──────────────────────────────
model TwoFactorAuth {
  id             String   @id @default(cuid())
  userId         String   @unique
  secret         String   // Encrypted TOTP secret
  isVerified     Boolean  @default(false)
  isEnabled      Boolean  @default(false)
  backupCodes    Json     // Encrypted array of recovery codes
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auths")
}

// ─── OAuth Client Model (Task 23-24: SSO/OIDC) ──────────────────────────────
model OAuthClient {
  id                 String    @id @default(cuid())
  clientId           String    @unique // Public client ID
  clientSecret       String    // Encrypted client secret
  name               String    // Application name
  description        String?   // Application description
  ownerUserId        String    // User who owns this client
  redirectUris       Json      // Array of allowed redirect URIs
  scopes             Json      // Array of allowed scopes
  isPublic           Boolean   @default(false) // For PKCE flows
  isActive           Boolean   @default(true)
  logoUrl            String?
  websiteUrl         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner              User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  authorizations     OAuthAuthorization[]
  authorizationCodes OAuthAuthorizationCode[]
  accessTokens       OAuthAccessToken[]
  refreshTokens      OAuthRefreshToken[]

  @@index([clientId])
  @@index([ownerUserId])
  @@map("oauth_clients")
}

// ─── OAuth User Authorization (Task 25: SSO) ────────────────────────────────
model OAuthAuthorization {
  id              String    @id @default(cuid())
  userId          String
  clientId        String
  scopes          Json      // Granted scopes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("oauth_authorizations")
}

// ─── OAuth Authorization Code (Task 24: OIDC) ───────────────────────────────
model OAuthAuthorizationCode {
  id            String    @id @default(cuid())
  code          String    @unique
  clientId      String
  userId        String
  redirectUri   String
  scopes        Json
  codeChallenge String?   // PKCE
  codeChallengeMethod String? // PKCE: S256 or plain
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

// ─── OAuth Access Token ─────────────────────────────────────────────────────
model OAuthAccessToken {
  id          String    @id @default(cuid())
  token       String    @unique
  clientId    String
  userId      String
  scopes      Json
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

// ─── OAuth Refresh Token ────────────────────────────────────────────────────
model OAuthRefreshToken {
  id            String    @id @default(cuid())
  token         String    @unique
  clientId      String
  userId        String
  scopes        Json
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("oauth_refresh_tokens")
}

// ─── Password Reset Token Model (Step 4) ────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─── Passkey Model (Task 13: WebAuthn) ──────────────────────────────────────
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique // Base64 encoded
  publicKey       String   @db.Text // Base64 encoded
  counter         BigInt   @default(0)
  deviceType      String   // 'singleDevice' or 'multiDevice'
  backedUp        Boolean  @default(false)
  transports      String[] // ['usb', 'ble', 'nfc', 'internal', 'hybrid']
  name            String?  // User-friendly name for the passkey
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}

// ─── Auth.js v5 Required Models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Role Enum ───────────────────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
  MODERATOR
  SUPERADMIN
}

// ─── Refresh Token Model ─────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Audit Log Model ─────────────────────────────────────────────────────────
model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
  PROFILE_UPDATE
  ROLE_CHANGE
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETED
  FAILED_LOGIN
  TOKEN_REFRESH
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ACCOUNT_LINKED
  ACCOUNT_UNLINKED
  BACKUP_EMAIL_UPDATED
  KYC_SUBMITTED
  KYC_VERIFIED
  KYC_REJECTED
}

// ─── OTP Model (Tasks 16-18: Unified OTP for all delivery methods) ───────────
model OtpCode {
  id          String    @id @default(cuid())
  userId      String?
  recipient   String    // email, phone, or telegram chatId
  recipientType String  // 'email', 'phone', 'telegram'
  code        String
  purpose     String    // 'login', 'verify-email', 'verify-phone', 'reset-password'
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([recipient, recipientType])
  @@index([code, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ─── OTP Rate Limiting (Task 18) ─────────────────────────────────────────────
model OtpRateLimit {
  id            String   @id @default(cuid())
  recipient     String
  recipientType String
  count         Int      @default(0)
  windowStart   DateTime
  windowEnd     DateTime
  
  @@unique([recipient, recipientType])
  @@index([windowEnd])
  @@map("otp_rate_limits")
}

// ─── KYC Record Model (Tasks 35-38) ─────────────────────────────────────────
model KYCRecord {
  id                String    @id @default(cuid())
  userId            String
  type              KYCType
  status            KYCStatus @default(PENDING)
  
  // Document details
  documentType      String?   // passport, national_id, driving_license
  documentNumber    String?   // Encrypted
  documentFrontUrl  String?   // Encrypted file path
  documentBackUrl   String?   // Encrypted file path
  
  // Selfie/Liveness
  selfieUrl         String?   // Encrypted file path
  videoSelfieUrl    String?   // Encrypted file path
  livenessScore     Float?    // 0.0 to 1.0
  
  // Face verification
  faceMatchScore    Float?    // 0.0 to 1.0
  
  // Third-party KYC service
  kycProvider       String?   // onfido, jumio, sumsub, etc.
  kycProviderId     String?   // External KYC provider's reference ID
  kycProviderResponse Json?   // Full response from provider
  
  // Review
  reviewedBy        String?   // Admin user ID who reviewed
  reviewedAt        DateTime?
  rejectionReason   String?
  
  // Privacy & Consent (Task 38)
  consentGiven      Boolean   @default(false)
  consentTimestamp  DateTime?
  dataRetentionPolicy String? // How long to keep data
  dataDeletedAt     DateTime?
  
  // Timestamps
  submittedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([kycProvider])
  @@map("kyc_records")
}

// ─── KYC Enums ──────────────────────────────────────────────────────────────
enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KYCType {
  ID_VERIFICATION
  FACE_VERIFICATION
  LIVENESS_CHECK
  FULL_KYC
}

enum VerificationTier {
  BASIC      // No KYC, basic features
  VERIFIED   // KYC completed, green tick badge
  PREMIUM    // Enhanced verification (optional future tier)
}

// ─── Security Checkup Model (Task 31) ───────────────────────────────────────
model SecurityCheckup {
  id              String   @id @default(cuid())
  userId          String
  securityScore   Int      // 0-100
  checklist       Json     // Array of security checks
  recommendations Json     // Array of recommendations
  lastCheckedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([lastCheckedAt])
  @@map("security_checkups")
}

// ─── Login Alert Model (Task 32) ────────────────────────────────────────────
model LoginAlert {
  id           String   @id @default(cuid())
  userId       String
  ipAddress    String
  userAgent    String
  deviceInfo   Json     // Parsed device information
  location     Json     // IP geolocation data
  riskLevel    String   // 'low', 'medium', 'high', 'critical'
  riskFactors  Json     // Array of risk factors
  isRecognized Boolean  @default(false)
  isAcknowledged Boolean @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@index([riskLevel])
  @@index([isAcknowledged])
  @@map("login_alerts")
}

// ─── Trusted Device Model (Task 33) ─────────────────────────────────────────
model TrustedDevice {
  id            String    @id @default(cuid())
  userId        String
  deviceFingerprint String // Hash of device characteristics
  deviceName    String?
  browser       String
  os            String
  ipAddress     String
  lastUsedAt    DateTime  @default(now())
  trustLevel    String    @default("trusted") // 'trusted', 'restricted'
  expiresAt     DateTime? // Optional expiration
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceFingerprint])
  @@index([isRevoked])
  @@map("trusted_devices")
}

// ─── Proactive Protection Log (Task 33) ─────────────────────────────────────
model ProactiveProtection {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // 'suspicious_login', 'brute_force', 'unusual_activity'
  severity    String   // 'low', 'medium', 'high', 'critical'
  action      String   // 'blocked', 'warned', 'locked'
  details     Json     // Event details
  ipAddress   String?
  userAgent   String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("proactive_protections")
}

// ─── Central Security Settings (Task 34) ────────────────────────────────────
model SecuritySettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  loginAlertsEnabled      Boolean  @default(true)
  trustedDevicesEnabled   Boolean  @default(true)
  proactiveProtection     Boolean  @default(true)
  suspiciousLoginDetection Boolean @default(true)
  locationBasedSecurity   Boolean  @default(true)
  deviceRecognition       Boolean  @default(true)
  automaticLockout        Boolean  @default(true)
  maxFailedAttempts       Int      @default(5)
  lockoutDuration         Int      @default(15) // minutes
  sessionTimeout          Int      @default(30) // minutes
  require2FAForTrusted    Boolean  @default(false)
  notifyOnNewDevice       Boolean  @default(true)
  notifyOnNewLocation     Boolean  @default(true)
  allowedCountries        Json?    // Array of allowed country codes
  blockedIPs              Json?    // Array of blocked IP addresses
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("security_settings")
}

