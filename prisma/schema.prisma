// iNAYA Auth 2.0 — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User Model ──────────────────────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String    @unique
  emailVerified   DateTime?
  backupEmail     String?   // Task 10: Backup email
  image           String?
  password        String?   // For credentials login (hashed with bcrypt)
  phoneNumber     String?   @unique // Task 9: Mobile number
  phoneVerified   DateTime? // Task 9: Phone verification timestamp
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  locale          String    @default("en")
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  accounts            Account[]
  sessions            Session[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passkeys            Passkey[]             // Task 13: WebAuthn passkeys
  passwordResetTokens PasswordResetToken[]  // Step 4: Password reset tokens
  twoFactorAuth       TwoFactorAuth?        // Task 20: 2FA TOTP

  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([role])
  @@map("users")
}

// ─── Two-Factor Authentication Model (Task 20) ──────────────────────────────
model TwoFactorAuth {
  id             String   @id @default(cuid())
  userId         String   @unique
  secret         String   // Encrypted TOTP secret
  isVerified     Boolean  @default(false)
  isEnabled      Boolean  @default(false)
  backupCodes    Json     // Encrypted array of recovery codes
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_auths")
}

// ─── Password Reset Token Model (Step 4) ────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─── Passkey Model (Task 13: WebAuthn) ──────────────────────────────────────
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique // Base64 encoded
  publicKey       String   @db.Text // Base64 encoded
  counter         BigInt   @default(0)
  deviceType      String   // 'singleDevice' or 'multiDevice'
  backedUp        Boolean  @default(false)
  transports      String[] // ['usb', 'ble', 'nfc', 'internal', 'hybrid']
  name            String?  // User-friendly name for the passkey
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}

// ─── Auth.js v5 Required Models ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Role Enum ───────────────────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
  MODERATOR
  SUPERADMIN
}

// ─── Refresh Token Model ─────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Audit Log Model ─────────────────────────────────────────────────────────
model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum AuditAction {
  LOGIN
  LOGOUT
  REGISTER
  PASSWORD_CHANGE
  PASSWORD_RESET
  PROFILE_UPDATE
  ROLE_CHANGE
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETED
  FAILED_LOGIN
  TOKEN_REFRESH
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ACCOUNT_LINKED
  ACCOUNT_UNLINKED
  BACKUP_EMAIL_UPDATED
}

// ─── OTP Model (Tasks 16-18: Unified OTP for all delivery methods) ───────────
model OtpCode {
  id          String    @id @default(cuid())
  userId      String?
  recipient   String    // email, phone, or telegram chatId
  recipientType String  // 'email', 'phone', 'telegram'
  code        String
  purpose     String    // 'login', 'verify-email', 'verify-phone', 'reset-password'
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([recipient, recipientType])
  @@index([code, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ─── OTP Rate Limiting (Task 18) ─────────────────────────────────────────────
model OtpRateLimit {
  id            String   @id @default(cuid())
  recipient     String
  recipientType String
  count         Int      @default(0)
  windowStart   DateTime
  windowEnd     DateTime
  
  @@unique([recipient, recipientType])
  @@index([windowEnd])
  @@map("otp_rate_limits")
}

