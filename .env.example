# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/inaya_auth?schema=public"

# ─── Auth.js v5 (NextAuth.js) ─────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-change-this-in-production"
AUTH_TRUST_HOST=true

# ─── Password Hashing (Task 22) ───────────────────────────────────────────────
# Algorithm: 'bcrypt' or 'argon2' (argon2 recommended for security)
PASSWORD_HASH_ALGORITHM="bcrypt"

# bcrypt config (if using bcrypt)
BCRYPT_ROUNDS="12"

# argon2 config (if using argon2)
ARGON2_TIME_COST="3"
ARGON2_MEMORY_COST="65536"  # 64 MB
ARGON2_PARALLELISM="4"

# Encryption key for 2FA secrets (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── OAuth Providers (Task 7) ─────────────────────────────────────────────────
# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook/Meta OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple OAuth
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_ISSUER=""  # e.g., https://login.microsoftonline.com/{tenant-id}/v2.0

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="iNAYA Auth 2.0"
NODE_ENV="development"

# ─── Email (Optional - for password reset) ────────────────────────────────────
# Provider: 'resend' or 'smtp'
EMAIL_PROVIDER="resend"
EMAIL_FROM="noreply@inaya-auth.com"
EMAIL_FROM_NAME="iNAYA Auth"

# Resend (recommended for production)
# RESEND_API_KEY="your-resend-api-key"

# SMTP (alternative)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# ─── Telegram Bot (Optional - for OTP delivery) ───────────────────────────────
# Create bot via @BotFather on Telegram
# Get webhook URL: https://api.telegram.org/bot<token>/setWebhook?url=<your-url>/api/telegram/webhook
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="iNAYAAuthBot"

# ─── SMS Provider (Optional - paid, extensible architecture) ──────────────────
# Provider: 'dev-console' | 'twilio' | 'vonage' | 'ssl-wireless' | 'bulksmsbd'
SMS_PROVIDER="dev-console"
# SMS_API_KEY=""
# SMS_API_SECRET=""
# SMS_SENDER_ID=""
# SMS_ACCOUNT_SID=""  # Twilio
# SMS_AUTH_TOKEN=""   # Twilio

# ─── WhatsApp Provider (Optional - paid, extensible architecture) ─────────────
# Provider: 'dev-console' | 'twilio' | 'meta' | '360dialog'
WHATSAPP_PROVIDER="dev-console"
# WHATSAPP_API_KEY=""
# WHATSAPP_API_SECRET=""
# WHATSAPP_SENDER_NUMBER=""
# WHATSAPP_ACCOUNT_SID=""  # Twilio
# WHATSAPP_AUTH_TOKEN=""   # Twilio
# WHATSAPP_BUSINESS_ACCOUNT_ID=""  # Meta

# ─── GitHub Token (for releases) ──────────────────────────────────────────────
# GITHUB_TOKEN="your-github-token"

# ─── KYC Configuration (Tasks 35-38) ─────────────────────────────────────────
# Upload directory for KYC documents (encrypted at rest)
KYC_UPLOAD_DIR="./uploads/kyc"

# Encryption key for KYC documents (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
KYC_ENCRYPTION_KEY=""

# Third-party KYC Providers (Optional - for enhanced verification)
# Only one provider is needed. Priority: onfido > jumio > sumsub

# Onfido (https://onfido.com)
# ONFIDO_API_KEY=""
# ONFIDO_WEBHOOK_SECRET=""

# Jumio (https://jumio.com)
# JUMIO_API_KEY=""
# JUMIO_API_SECRET=""

# Sumsub (https://sumsub.com)
# SUMSUB_API_KEY=""
# SUMSUB_SECRET=""

# Face Verification Service (Optional - if not using KYC provider)
# AWS Rekognition
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# Azure Face API
# AZURE_FACE_API_KEY=""
# AZURE_FACE_ENDPOINT=""
